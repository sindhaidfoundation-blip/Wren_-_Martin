{
  "expo": {
    "name": "Wren & Martin Grammar Master",
    "slug": "wren-martin-grammar-master",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "web": {
      "bundler": "metro"
    },
    "experiments": {
      "baseUrl": "/Wren_-_Martin"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.grammar.master.wrenmartin"
    },
    "android": {
      "package": "com.grammar.master.wrenmartin",
      "adaptiveIcon": {
        "backgroundColor": "#101C3A"
      },
      "allowBackup": false
    },
    "plugins": [
      [
        "react-native-google-mobile-ads",
        {
          "androidAppId": "ca-app-pub-4568292017940942~2885847236",
          "delayAppMeasurementInit": true,
          "iosAppId": "ca-app-pub-3940256099942544~1458002511"
        }
      ]
    ],
    "newArchEnabled": true
  }
}
