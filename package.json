{
  "name": "wren-martin-grammar-master",
  "version": "1.0.0",
  "private": true,
  "main": "node_modules/expo/AppEntry.js",
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "check:expo": "npx expo-doctor",
    "check:config": "node scripts/validate-expo-config.mjs",
    "prebuild:android": "expo prebuild --platform android",
    "prebuild:ios": "expo prebuild --platform ios",
    "build:android:release": "npm run prebuild:android && cd android && ./gradlew assembleRelease"
  },
  "dependencies": {
    "expo": "~57.0.0",
    "expo-status-bar": "~57.0.1",
    "@expo/metro-runtime": "~57.0.18",
    "@react-native-async-storage/async-storage": "2.2.0",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-web": "~0.21.0",
    "expo-print": "~57.0.2",
    "expo-sharing": "~57.0.26",
    "react-native-google-mobile-ads": "^17.4.0"
  },
  "devDependencies": {},
  "overrides": {
    "@expo/inline-modules": "0.1.9"
  }
}
